Updated C# Code with Batch User Import:

using Microsoft.Graph;
using Azure.Identity;
using System;
using System.IO;
using CsvHelper;
using System.Globalization;
using System.Linq;
using System.Threading.Tasks;
using System.Collections.Generic;

class User
{
    public string Email { get; set; }
    public string GivenName { get; set; }
    public string Surname { get; set; }
    public string DisplayName { get; set; }
    public string Password { get; set; }
    public string Role { get; set; }
}

class Program
{
    static async Task Main(string[] args)
    {
        // Azure AD B2C Configuration
        var tenantId = "<your-tenant-id>";
        var clientId = "<your-client-id>";
        var clientSecret = "<your-client-secret>";

        // Initialize Graph Client
        var credential = new ClientSecretCredential(tenantId, clientId, clientSecret);
        var graphClient = new GraphServiceClient(credential);

        // CSV and Log Paths
        string csvPath = @"C:\Path\to\users.csv";
        string logPath = @"C:\Path\to\error_log.txt";

        // Read users from CSV
        var users = ReadUsersFromCsv(csvPath);

        // Create Role Groups if they don't exist
        var roleGroups = await EnsureRoleGroupsExist(graphClient, users.Select(u => u.Role).Distinct().ToList());

        // Batch Import Users
        await ImportUsersInBatch(graphClient, users, roleGroups, logPath);

        Console.WriteLine("Batch import and role assignment completed.");
    }

    // Read Users from CSV
    static List<User> ReadUsersFromCsv(string path)
    {
        using var reader = new StreamReader(path);
        using var csv = new CsvReader(reader, CultureInfo.InvariantCulture);
        return csv.GetRecords<User>().ToList();
    }

    // Ensure Role Groups Exist
    static async Task<Dictionary<string, string>> EnsureRoleGroupsExist(GraphServiceClient client, List<string> roles)
    {
        var roleGroups = new Dictionary<string, string>();
        var allGroups = await PaginatedRequest(client.Groups.Request().Filter("securityEnabled eq true"));

        foreach (var role in roles)
        {
            var group = allGroups.FirstOrDefault(g => g.DisplayName == role);
            if (group == null)
            {
                var newGroup = new Group
                {
                    DisplayName = role,
                    SecurityEnabled = true,
                    MailEnabled = false,
                    MailNickname = role
                };
                var createdGroup = await client.Groups.Request().AddAsync(newGroup);
                roleGroups[role] = createdGroup.Id;
                Console.WriteLine($"Created new group: {role}");
            }
            else
            {
                roleGroups[role] = group.Id;
                Console.WriteLine($"Group already exists: {role}");
            }
        }
        return roleGroups;
    }

    // Batch Import Users
    static async Task ImportUsersInBatch(GraphServiceClient client, List<User> users, Dictionary<string, string> roleGroups, string logPath)
    {
        int batchSize = 20;
        var batches = users
            .Select((user, index) => new { user, index })
            .GroupBy(x => x.index / batchSize)
            .Select(g => g.Select(x => x.user).ToList())
            .ToList();

        foreach (var batch in batches)
        {
            var batchRequestContent = new BatchRequestContent();

            // Create Users in Batch
            foreach (var user in batch)
            {
                var newUser = new Microsoft.Graph.User
                {
                    AccountEnabled = true,
                    DisplayName = user.DisplayName,
                    MailNickname = user.GivenName,
                    UserPrincipalName = user.Email,
                    PasswordProfile = new PasswordProfile
                    {
                        ForceChangePasswordNextSignIn = false,
                        Password = user.Password
                    },
                    GivenName = user.GivenName,
                    Surname = user.Surname
                };
                var request = client.Users.Request().WithMaxRetry(3).GetHttpRequestMessage();
                request.Content = System.Text.Json.JsonSerializer.SerializeToUtf8Bytes(newUser);
                batchRequestContent.AddBatchRequestStep(request);
            }

            // Execute Batch Request
            var response = await client.Batch.Request().PostAsync(batchRequestContent);

            // Handle Responses
            foreach (var result in response.GetResponses())
            {
                if (result.Value.IsSuccessStatusCode)
                {
                    var user = batch.FirstOrDefault(u => u.Email == result.Value.Headers.Location?.ToString());
                    Console.WriteLine($"User created: {user.Email}");

                    // Assign to Role Group
                    if (roleGroups.ContainsKey(user.Role))
                    {
                        await AssignUserToGroup(client, user.Email, roleGroups[user.Role]);
                        Console.WriteLine($"Assigned {user.Email} to {user.Role} group");
                    }
                }
                else
                {
                    var user = batch.FirstOrDefault(u => u.Email == result.Key);
                    LogError(logPath, user.Email, result.Value.ReasonPhrase);
                    Console.WriteLine($"Failed to import {user.Email}. Error logged.");
                }
            }
        }
    }

    // Assign User to Group (Role)
    static async Task AssignUserToGroup(GraphServiceClient client, string userId, string groupId)
    {
        var directoryObject = new DirectoryObject { Id = userId };
        await client.Groups[groupId].Members.References.Request().AddAsync(directoryObject);
    }

    // Log Errors to File
    static void LogError(string path, string email, string message)
    {
        using (var writer = new StreamWriter(path, true))
        {
            writer.WriteLine($"{DateTime.Now}: Failed to import {email}. Error: {message}");
        }
    }

    // Pagination for Groups
    static async Task<List<Group>> PaginatedRequest(IGraphServiceGroupsCollectionRequest request)
    {
        var allItems = new List<Group>();
        while (request != null)
        {
            var response = await request.GetAsync();
            allItems.AddRange(response.CurrentPage);
            request = response.NextPageRequest;
        }
        return allItems;
    }
}


