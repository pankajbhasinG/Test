3. C# Code to Automate User and Role Import

using Microsoft.Graph;
using Azure.Identity;
using System;
using System.IO;
using CsvHelper;
using System.Globalization;
using System.Linq;
using System.Threading.Tasks;
using System.Collections.Generic;

class User
{
    public string Email { get; set; }
    public string GivenName { get; set; }
    public string Surname { get; set; }
    public string DisplayName { get; set; }
    public string Password { get; set; }
    public string Role { get; set; }
}

class Program
{
    static async Task Main(string[] args)
    {
        // Azure AD B2C Configurations
        var tenantId = "<your-tenant-id>";
        var clientId = "<your-client-id>";
        var clientSecret = "<your-client-secret>";

        // Initialize Graph Client
        var credential = new ClientSecretCredential(tenantId, clientId, clientSecret);
        var graphClient = new GraphServiceClient(credential);

        // Path to CSV file
        string csvPath = @"C:\Path\to\users.csv";
        var users = ReadUsersFromCsv(csvPath);

        // Step 1: Create/Ensure Role Groups
        var roleGroups = await EnsureRoleGroupsExist(graphClient, users.Select(u => u.Role).Distinct().ToList());

        // Step 2: Import Users and Assign to Roles
        foreach (var user in users)
        {
            try
            {
                var createdUser = await CreateUser(graphClient, user);
                Console.WriteLine($"User created: {user.Email}");

                // Assign to Role Group
                if (roleGroups.ContainsKey(user.Role))
                {
                    await AssignUserToGroup(graphClient, createdUser.Id, roleGroups[user.Role]);
                    Console.WriteLine($"Assigned {user.Email} to {user.Role} group");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Failed to import user {user.Email}: {ex.Message}");
            }
        }

        Console.WriteLine("User import and role assignment completed.");
    }

    // Read Users from CSV
    static List<User> ReadUsersFromCsv(string path)
    {
        using var reader = new StreamReader(path);
        using var csv = new CsvReader(reader, CultureInfo.InvariantCulture);
        return csv.GetRecords<User>().ToList();
    }

    // Ensure Role Groups Exist or Create Them
    static async Task<Dictionary<string, string>> EnsureRoleGroupsExist(GraphServiceClient client, List<string> roles)
    {
        var roleGroups = new Dictionary<string, string>();
        var existingGroups = await client.Groups.Request()
            .Filter("securityEnabled eq true")
            .GetAsync();

        foreach (var role in roles)
        {
            var group = existingGroups.FirstOrDefault(g => g.DisplayName == role);
            if (group == null)
            {
                var newGroup = new Group
                {
                    DisplayName = role,
                    SecurityEnabled = true,
                    MailEnabled = false,
                    MailNickname = role
                };
                var createdGroup = await client.Groups.Request().AddAsync(newGroup);
                roleGroups[role] = createdGroup.Id;
                Console.WriteLine($"Created new role group: {role}");
            }
            else
            {
                roleGroups[role] = group.Id;
                Console.WriteLine($"Role group already exists: {role}");
            }
        }
        return roleGroups;
    }

    // Create User in Azure AD B2C
    static async Task<User> CreateUser(GraphServiceClient client, User user)
    {
        var newUser = new Microsoft.Graph.User
        {
            AccountEnabled = true,
            DisplayName = user.DisplayName,
            MailNickname = user.GivenName,
            UserPrincipalName = user.Email,
            PasswordProfile = new PasswordProfile
            {
                ForceChangePasswordNextSignIn = false,
                Password = user.Password
            },
            GivenName = user.GivenName,
            Surname = user.Surname
        };

        return await client.Users.Request().AddAsync(newUser);
    }

    // Assign User to Group (Role)
    static async Task AssignUserToGroup(GraphServiceClient client, string userId, string groupId)
    {
        var directoryObject = new DirectoryObject { Id = userId };
        await client.Groups[groupId].Members.References.Request().AddAsync(directoryObject);
    }
}


