                roleGroups[role] = group.Id;
                Console.WriteLine($"Group already exists: {role}");
            }
        }
        return roleGroups;
    }

    // Create User in Azure AD B2C
    static async Task<User> CreateUser(GraphServiceClient client, User user)
    {
