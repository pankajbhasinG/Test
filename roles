    static async Task<Dictionary<string, string>> EnsureRoleGroupsExist(GraphServiceClient client, List<string> roles)
    {
        var roleGroups = new Dictionary<string, string>();

        // Get all groups using pagination
        var allGroups = await PaginatedRequest(client.Groups.Request().Filter("securityEnabled eq true"));

        foreach (var role in roles)
        {
            var group = allGroups.FirstOrDefault(g => g.DisplayName == role);
            if (group == null)
