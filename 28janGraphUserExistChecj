Log each user's identities to ensure the email is checked:

foreach (var user in allUsers.CurrentPage)
{
    Console.WriteLine($"User: {user.DisplayName}");
    if (user.Identities != null)
    {
        foreach (var identity in user.Identities)
        {
            Console.WriteLine($"Identity: {identity.IssuerAssignedId}, Issuer: {identity.Issuer}");
        }
    }
}


