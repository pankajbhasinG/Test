Here's how you can use C# to manage the extension_RequirePasswordChange attribute in Azure AD B2C using the Microsoft Graph SDK:


---

Step 1: Install Microsoft Graph SDK

Add the Microsoft Graph SDK to your project:

dotnet add package Microsoft.Graph
dotnet add package Microsoft.Identity.Client


---

Step 2: Authenticate with Microsoft Graph

Create an authentication provider using the Microsoft.Identity.Client library. This example uses client credentials for app-only authentication.

Authentication Code

using Azure.Identity;
using Microsoft.Graph;

public class GraphHelper
{
    private static GraphServiceClient graphClient;

    public static GraphServiceClient GetGraphClient()
    {
        // App registration details
        var tenantId = "<Your-Tenant-ID>";
        var clientId = "<Your-Client-ID>";
        var clientSecret = "<Your-Client-Secret>";

        var clientSecretCredential = new ClientSecretCredential(tenantId, clientId, clientSecret);

        graphClient = new GraphServiceClient(clientSecretCredential);
        return graphClient;
    }
}


---

Step 3: Update the extension_RequirePasswordChange Attribute

Set the Attribute

Use the UpdateUserAsync method to set the custom attribute for a specific user. Replace <AppId> with your Application ID (without dashes).

using System;
using System.Threading.Tasks;
using Microsoft.Graph;

class Program
{
    static async Task Main(string[] args)
    {
        var graphClient = GraphHelper.GetGraphClient();

        // User ID or email
        var userId = "user@example.com"; // or ObjectId

        // Update the extension attribute
        var extensionName = "extension_<AppId>_RequirePasswordChange"; // Replace <AppId>
        var userUpdate = new User
        {
            AdditionalData = new System.Collections.Generic.Dictionary<string, object>
            {
                { extensionName, true }
            }
        };

        try
        {
            await graphClient.Users[userId]
                .Request()
                .UpdateAsync(userUpdate);

            Console.WriteLine($"Updated user {userId} with RequirePasswordChange.");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating user: {ex.Message}");
        }
    }
}


