2. Controller Sample

[ApiController]
[Route("api/[controller]")]
public class TestController : ControllerBase
{
    [HttpGet("ping")]
    [AllowAnonymous]
    public IActionResult Ping() => Ok("pong");

    [HttpGet("secure")]
    [Authorize]
    public IActionResult SecureData() => Ok("This is protected data");
}


